rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrador";
    }

    function challengeDoc(challengeId) {
      return get(/databases/$(database)/documents/challenges/$(challengeId));
    }

    function isProtagonist(challengeId) {
      return signedIn()
        && (
          (challengeDoc(challengeId).data.protagonistUids is list
            && challengeDoc(challengeId).data.protagonistUids.hasAny([request.auth.uid]))
          || (challengeDoc(challengeId).data.protagonistUid == request.auth.uid)
          || (challengeDoc(challengeId).data.protagonistEmails is list
            && challengeDoc(challengeId).data.protagonistEmails.hasAny([request.auth.token.email]))
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == "usuario";

      allow update, delete: if isAdmin();

      match /reminders/{reminderId} {
        allow read, create, update, delete:
          if signedIn() && request.auth.uid == userId;
      }
    }

    match /challenges/{challengeId} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();

      match /participants/{userId} {
        allow read: if isAdmin()
                   || (signedIn()
                       && challengeDoc(challengeId).data.published == true
                       && resource.data.published == true);

        // Publicación directa: cada familiar puede crear su propia participación
        // ya publicada, siempre que la locura del mes esté publicada.
        allow create: if signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.uid == request.auth.uid
                      && challengeDoc(challengeId).data.published == true
                      && request.resource.data.published == true
                      && request.resource.data.status == "published"
                      && request.resource.data.name is string;

        allow update: if isAdmin()
                      || (
                        signedIn()
                        && request.auth.uid == userId
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.published == true
                        && request.resource.data.status == "published"
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "text", "audioData", "updatedAt", "submittedAt", "published", "status"])
                      )
                      || (
                        isProtagonist(challengeId)
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.published == resource.data.published
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["score", "scoredAt", "scoredBy"])
                      );

        allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);

        match /likes/{likerId} {
          allow read: if signedIn();

          allow create: if signedIn()
                        && request.auth.uid == likerId
                        && likerId != userId
                        && challengeDoc(challengeId).data.published == true
                        && get(/databases/$(database)/documents/challenges/$(challengeId)/participants/$(userId)).data.published == true
                        && request.resource.data.uid == request.auth.uid;

          allow delete: if signedIn() && request.auth.uid == likerId;
          allow update: if false;
        }
      }
    }
  }
}
