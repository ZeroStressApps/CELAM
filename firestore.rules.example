rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrador";
    }

    function challengeDoc(challengeId) {
      return get(/databases/$(database)/documents/challenges/$(challengeId));
    }

    function isProtagonist(challengeId) {
      return signedIn()
        && (
          (challengeDoc(challengeId).data.protagonistUids is list
            && challengeDoc(challengeId).data.protagonistUids.hasAny([request.auth.uid]))
          || (challengeDoc(challengeId).data.protagonistUid == request.auth.uid)
          || (challengeDoc(challengeId).data.protagonistEmails is list
            && challengeDoc(challengeId).data.protagonistEmails.hasAny([request.auth.token.email]))
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == "usuario";

      allow update, delete: if isAdmin();

      match /reminders/{reminderId} {
        allow read, create, update, delete:
          if signedIn() && request.auth.uid == userId;
      }
    }

    match /challenges/{challengeId} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();

      match /participants/{userId} {
        allow read: if signedIn();

        // Un familiar puede registrar/editar su propia participación,
        // pero nunca puede publicarla ni marcarla como aprobada.
        allow create: if signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.published == false
                      && request.resource.data.status == "pending";

        allow update: if isAdmin()
                      || (
                        signedIn()
                        && request.auth.uid == userId
                        && request.resource.data.published == resource.data.published
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.score == resource.data.score
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["submissionUrl", "title", "text", "updatedAt"])
                      )
                      || (
                        isProtagonist(challengeId)
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.published == resource.data.published
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["score", "scoredAt", "scoredBy"])
                      );

        allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);

        match /votes/{voterId} {
          allow read: if signedIn();

          allow create: if signedIn()
                        && request.auth.uid == voterId
                        && voterId != userId
                        && challengeDoc(challengeId).data.published == true
                        && get(/databases/$(database)/documents/challenges/$(challengeId)/participants/$(userId)).data.published == true
                        && request.resource.data.uid == request.auth.uid;

          allow delete: if signedIn() && request.auth.uid == voterId;
          allow update: if false;
        }
      }
    }
  }
}
