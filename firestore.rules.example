rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrador";
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // New users may only create their own profile with the initial role.
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == "usuario";

      // Only an administrator can change/delete profiles.
      allow update, delete: if isAdmin();
    }

    match /users/{userId}/reminders/{reminderId} {
      allow read, create, update, delete: if signedIn()
                                           && request.auth.uid == userId;
    }
  }
}
